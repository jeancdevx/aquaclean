              "reject",
              "correct"
            ],
            "title": "Action"
          },
          "proposal_hash": {
            "type": "string",
            "title": "Proposal Hash"
          },
          "case_version": {
            "type": "integer",
            "title": "Case Version"
          },
          "selection": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Selection"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "action",
          "proposal_hash",
          "case_version"
        ],
        "title": "ReviewDecision"
      },
      "ValidationError": {
        "properties": {
