            "title": "Event Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "inspection",
              "reprocess",
              "customer_acceptance",
              "fulfillment",
              "conformity",
              "observation",
              "pickup",
              "delivery"
            ],
            "title": "Kind"
          },
          "note": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 8,
            "title": "Note"
          },
          "attachment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attachment Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "kind",
          "note"
        ],
        "title": "OperatorEvent"
      },
      "OrderLink": {
        "properties": {
          "order_number": {
            "type": "string",
            "maxLength": 80,
            "minLength": 4,
            "title": "Order Number"
          },
          "expected_version": {
            "type": "integer",
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
