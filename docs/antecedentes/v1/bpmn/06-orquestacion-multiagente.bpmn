      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Orquestacion_Calidad" bpmnElement="Orquestacion_Calidad">
        <dc:Bounds x="1527.0" y="132.0" width="166" height="86"/>
