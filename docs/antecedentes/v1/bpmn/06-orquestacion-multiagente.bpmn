      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Orquestacion_F04" bpmnElement="Orquestacion_F04">
        <di:waypoint x="988.0" y="535.0"/>
        <di:waypoint x="1113.0" y="535.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Orquestacion_F05" bpmnElement="Orquestacion_F05">
        <di:waypoint x="1167.0" y="535.0"/>
