<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn" id="Definitions_Orquestacion" targetNamespace="https://aquaclean.example/bpmn" exporter="Aqua Clean - diseño académico BPMN 2.0" exporterVersion="1.0">
  <bpmn:error id="Err_Orquestacion_Error" name="Fallo técnico" errorCode="TECHNICAL_FAILURE"/>
  <bpmn:collaboration id="Collaboration_Orquestacion">
    <bpmn:participant id="Pool_Orquestacion" name="Aqua Clean S.A.C. · Orquestación técnica · Resolver un caso con especialistas" processRef="Process_Orquestacion"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Orquestacion" name="Orquestación técnica · Resolver un caso con especialistas" isExecutable="false">
    <bpmn:documentation>Modelo TO BE propuesto. Los LLM producen propuestas con evidencia; la política, las autorizaciones humanas y los servicios deterministas controlan los cambios. Detalle en el documento del proceso. No es un workflow BPMN ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Orquestacion">
      <bpmn:lane id="Orquestacion_Lane0" name="Supervisor y especialistas (LangChain / LangGraph)">
        <bpmn:flowNodeRef>Orquestacion_Ruta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Atencion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Logistica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Calidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Incidencias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Orquestacion_Lane1" name="Servicios, evidencia y política determinista">
        <bpmn:flowNodeRef>Orquestacion_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Cargar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_ValidarRuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Elegir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_HITL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Ejecutar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Orquestacion_Lane2" name="Operador humano / administrador">
        <bpmn:flowNodeRef>Orquestacion_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Autorizada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_Cola</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Orquestacion_FinPend</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Orquestacion_S" name="Evento de negocio autenticado">
      <bpmn:outgoing>Orquestacion_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Orquestacion_Cargar" name="Validar evento y cargar estado del caso">
      <bpmn:incoming>Orquestacion_F01</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Orquestacion_Ruta" name="Proponer intención y especialista con evidencia">
      <bpmn:incoming>Orquestacion_F02</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Orquestacion_ValidarRuta" name="Validar ruta, acceso y presupuesto">
      <bpmn:incoming>Orquestacion_F03</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F04</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Orquestacion_Elegir" name="¿Dominio autorizado?" default="Orquestacion_F09">
      <bpmn:incoming>Orquestacion_F04</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F05</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F06</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F07</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F08</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Orquestacion_Atencion" name="Agente de atención · P1">
      <bpmn:incoming>Orquestacion_F05</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Orquestacion_Logistica" name="Agente de logística · P2">
      <bpmn:incoming>Orquestacion_F06</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Orquestacion_Calidad" name="Agente de calidad · P3">
      <bpmn:incoming>Orquestacion_F07</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Orquestacion_Incidencias" name="Agente de incidencias · P4">
      <bpmn:incoming>Orquestacion_F08</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Orquestacion_Merge" name="Consolidar una propuesta">
      <bpmn:incoming>Orquestacion_F10</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F11</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F12</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F13</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Orquestacion_Policy" name="Validar esquema, evidencia, versión y permisos">
      <bpmn:incoming>Orquestacion_F14</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F15</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Orquestacion_HITL" name="¿Requiere revisión humana?" default="Orquestacion_F17">
      <bpmn:incoming>Orquestacion_F15</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F16</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Orquestacion_Revisar" name="Revisar la propuesta vinculada a su versión">
      <bpmn:incoming>Orquestacion_F17</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Orquestacion_Autorizada" name="¿Propuesta autorizada y vigente?" default="Orquestacion_F20">
      <bpmn:incoming>Orquestacion_F18</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F19</bpmn:outgoing>
      <bpmn:outgoing>Orquestacion_F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Orquestacion_Ejecutar" name="Ejecutar comando idempotente autorizado">
      <bpmn:incoming>Orquestacion_F16</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F19</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Orquestacion_Error" name="Fallo técnico / conflicto" attachedToRef="Orquestacion_Ejecutar" cancelActivity="true">
      <bpmn:outgoing>Orquestacion_F22</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Def_Orquestacion_Error" errorRef="Err_Orquestacion_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Orquestacion_Resultado" name="Persistir resultado y emitir notificación por outbox">
      <bpmn:incoming>Orquestacion_F21</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Orquestacion_Fin" name="Caso actualizado con trazas">
      <bpmn:incoming>Orquestacion_F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Orquestacion_Cola" name="Guardar pendiente y asignar responsable">
      <bpmn:incoming>Orquestacion_F09</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F20</bpmn:incoming>
      <bpmn:incoming>Orquestacion_F22</bpmn:incoming>
      <bpmn:outgoing>Orquestacion_F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Orquestacion_FinPend" name="Caso pendiente de atención">
      <bpmn:incoming>Orquestacion_F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Orquestacion_F01" sourceRef="Orquestacion_S" targetRef="Orquestacion_Cargar"/>
    <bpmn:sequenceFlow id="Orquestacion_F02" sourceRef="Orquestacion_Cargar" targetRef="Orquestacion_Ruta"/>
    <bpmn:sequenceFlow id="Orquestacion_F03" sourceRef="Orquestacion_Ruta" targetRef="Orquestacion_ValidarRuta"/>
    <bpmn:sequenceFlow id="Orquestacion_F04" sourceRef="Orquestacion_ValidarRuta" targetRef="Orquestacion_Elegir"/>
    <bpmn:sequenceFlow id="Orquestacion_F05" name="Atención" sourceRef="Orquestacion_Elegir" targetRef="Orquestacion_Atencion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dominio == atencion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F06" name="Logística" sourceRef="Orquestacion_Elegir" targetRef="Orquestacion_Logistica">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dominio == logistica</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F07" name="Calidad" sourceRef="Orquestacion_Elegir" targetRef="Orquestacion_Calidad">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dominio == calidad</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F08" name="Incidencias" sourceRef="Orquestacion_Elegir" targetRef="Orquestacion_Incidencias">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">dominio == incidencias</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F09" name="Ambiguo / no autorizado" sourceRef="Orquestacion_Elegir" targetRef="Orquestacion_Cola"/>
    <bpmn:sequenceFlow id="Orquestacion_F10" sourceRef="Orquestacion_Atencion" targetRef="Orquestacion_Merge"/>
    <bpmn:sequenceFlow id="Orquestacion_F11" sourceRef="Orquestacion_Logistica" targetRef="Orquestacion_Merge"/>
    <bpmn:sequenceFlow id="Orquestacion_F12" sourceRef="Orquestacion_Calidad" targetRef="Orquestacion_Merge"/>
    <bpmn:sequenceFlow id="Orquestacion_F13" sourceRef="Orquestacion_Incidencias" targetRef="Orquestacion_Merge"/>
    <bpmn:sequenceFlow id="Orquestacion_F14" sourceRef="Orquestacion_Merge" targetRef="Orquestacion_Policy"/>
    <bpmn:sequenceFlow id="Orquestacion_F15" sourceRef="Orquestacion_Policy" targetRef="Orquestacion_HITL"/>
    <bpmn:sequenceFlow id="Orquestacion_F16" name="Permitido automáticamente" sourceRef="Orquestacion_HITL" targetRef="Orquestacion_Ejecutar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">politica_auto_permitida</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F17" name="Revisión / evidencia insuficiente" sourceRef="Orquestacion_HITL" targetRef="Orquestacion_Revisar"/>
    <bpmn:sequenceFlow id="Orquestacion_F18" sourceRef="Orquestacion_Revisar" targetRef="Orquestacion_Autorizada"/>
    <bpmn:sequenceFlow id="Orquestacion_F19" name="Sí" sourceRef="Orquestacion_Autorizada" targetRef="Orquestacion_Ejecutar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">autorizacion_valida and version_vigente</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Orquestacion_F20" name="No" sourceRef="Orquestacion_Autorizada" targetRef="Orquestacion_Cola"/>
    <bpmn:sequenceFlow id="Orquestacion_F21" sourceRef="Orquestacion_Ejecutar" targetRef="Orquestacion_Resultado"/>
    <bpmn:sequenceFlow id="Orquestacion_F22" name="Sin confirmar efectos" sourceRef="Orquestacion_Error" targetRef="Orquestacion_Cola"/>
    <bpmn:sequenceFlow id="Orquestacion_F23" sourceRef="Orquestacion_Resultado" targetRef="Orquestacion_Fin"/>
    <bpmn:sequenceFlow id="Orquestacion_F24" sourceRef="Orquestacion_Cola" targetRef="Orquestacion_FinPend"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Orquestacion">
    <bpmndi:BPMNPlane id="Plane_Orquestacion" bpmnElement="Collaboration_Orquestacion">
      <bpmndi:BPMNShape id="Shape_Pool_Orquestacion" bpmnElement="Pool_Orquestacion" isHorizontal="true">
        <dc:Bounds x="50" y="50" width="3600" height="1080"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Orquestacion_Lane0" bpmnElement="Orquestacion_Lane0" isHorizontal="true">
        <dc:Bounds x="80" y="50" width="3570" height="360"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Orquestacion_Lane1" bpmnElement="Orquestacion_Lane1" isHorizontal="true">
        <dc:Bounds x="80" y="410" width="3570" height="360"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Orquestacion_Lane2" bpmnElement="Orquestacion_Lane2" isHorizontal="true">
        <dc:Bounds x="80" y="770" width="3570" height="360"/>
      </bpmndi:BPMNShape>
