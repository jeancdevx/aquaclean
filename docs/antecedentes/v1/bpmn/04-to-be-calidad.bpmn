<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn" id="Definitions_P3" targetNamespace="https://aquaclean.example/bpmn" exporter="Aqua Clean - diseño académico BPMN 2.0" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_P3">
    <bpmn:participant id="Pool_P3" name="Aqua Clean S.A.C. · P3 · Analizar observaciones de calidad y recomendar tratamiento" processRef="Process_P3"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P3" name="P3 · Analizar observaciones de calidad y recomendar tratamiento" isExecutable="false">
    <bpmn:documentation>Modelo TO BE propuesto. Los LLM producen propuestas con evidencia; la política, las autorizaciones humanas y los servicios deterministas controlan los cambios. Detalle en el documento del proceso. No es un workflow BPMN ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_P3">
      <bpmn:lane id="P3_Lane0" name="Personal de planta / control de calidad">
        <bpmn:flowNodeRef>P3_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Inspeccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Completar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Nueva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_FinPend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Reproceso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Conforme</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_Lane1" name="Agente de calidad / supervisor">
        <bpmn:flowNodeRef>P3_Analizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Suficiente</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_Lane2" name="Servicios de evidencia, política y órdenes">
        <bpmn:flowNodeRef>P3_Evidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_Incidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_FinInc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_S" name="Lote o prendas observadas">
      <bpmn:outgoing>P3_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="P3_Inspeccion" name="Inspeccionar prendas y documentar hallazgos">
      <bpmn:incoming>P3_F01</bpmn:incoming>
      <bpmn:outgoing>P3_F02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="P3_Evidencia" name="Recuperar guía, historial y procedimientos vigentes">
      <bpmn:incoming>P3_F02</bpmn:incoming>
      <bpmn:incoming>P3_F08</bpmn:incoming>
      <bpmn:outgoing>P3_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P3_Analizar" name="Contrastar hallazgos y proponer una disposición">
      <bpmn:incoming>P3_F03</bpmn:incoming>
      <bpmn:outgoing>P3_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_Suficiente" name="¿Hay evidencia suficiente?" default="P3_F06">
      <bpmn:incoming>P3_F04</bpmn:incoming>
      <bpmn:outgoing>P3_F05</bpmn:outgoing>
      <bpmn:outgoing>P3_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_Completar" name="Completar evidencia o descartar el análisis">
      <bpmn:incoming>P3_F06</bpmn:incoming>
      <bpmn:outgoing>P3_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_Nueva" name="¿Puede continuar?" default="P3_F09">
      <bpmn:incoming>P3_F07</bpmn:incoming>
      <bpmn:outgoing>P3_F08</bpmn:outgoing>
      <bpmn:outgoing>P3_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P3_FinPend" name="Caso pendiente de evaluación técnica">
      <bpmn:incoming>P3_F09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="P3_Validar" name="Comprobar restricciones y evidencia citada">
      <bpmn:incoming>P3_F05</bpmn:incoming>
      <bpmn:outgoing>P3_F10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="P3_Revisar" name="Evaluar propuesta y autorizar disposición">
      <bpmn:incoming>P3_F10</bpmn:incoming>
      <bpmn:outgoing>P3_F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P3_Decision" name="¿Disposición humana?" default="P3_F14">
      <bpmn:incoming>P3_F11</bpmn:incoming>
      <bpmn:outgoing>P3_F12</bpmn:outgoing>
      <bpmn:outgoing>P3_F13</bpmn:outgoing>
      <bpmn:outgoing>P3_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="P3_Reproceso" name="Ejecutar reproceso autorizado según procedimiento">
      <bpmn:incoming>P3_F13</bpmn:incoming>
      <bpmn:outgoing>P3_F15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="P3_Verificar" name="Verificar resultado del reproceso (máx. 1 ciclo)">
      <bpmn:incoming>P3_F15</bpmn:incoming>
      <bpmn:outgoing>P3_F16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="P3_Conforme" name="¿Resultado conforme?" default="P3_F18">
      <bpmn:incoming>P3_F16</bpmn:incoming>
      <bpmn:outgoing>P3_F17</bpmn:outgoing>
      <bpmn:outgoing>P3_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_Registrar" name="Registrar disposición conforme con evidencia">
      <bpmn:incoming>P3_F12</bpmn:incoming>
      <bpmn:incoming>P3_F17</bpmn:incoming>
      <bpmn:outgoing>P3_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_Fin" name="Lote liberado por control de calidad">
      <bpmn:incoming>P3_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P3_Incidencia" name="Abrir expediente de incidencia para P4">
      <bpmn:incoming>P3_F14</bpmn:incoming>
      <bpmn:incoming>P3_F18</bpmn:incoming>
      <bpmn:outgoing>P3_F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="P3_FinInc" name="Incidencia abierta; lote retenido">
      <bpmn:incoming>P3_F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_F01" sourceRef="P3_S" targetRef="P3_Inspeccion"/>
    <bpmn:sequenceFlow id="P3_F02" sourceRef="P3_Inspeccion" targetRef="P3_Evidencia"/>
    <bpmn:sequenceFlow id="P3_F03" sourceRef="P3_Evidencia" targetRef="P3_Analizar"/>
    <bpmn:sequenceFlow id="P3_F04" sourceRef="P3_Analizar" targetRef="P3_Suficiente"/>
    <bpmn:sequenceFlow id="P3_F05" name="Sí" sourceRef="P3_Suficiente" targetRef="P3_Validar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">evidencia_suficiente</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P3_F06" name="No" sourceRef="P3_Suficiente" targetRef="P3_Completar"/>
    <bpmn:sequenceFlow id="P3_F07" sourceRef="P3_Completar" targetRef="P3_Nueva"/>
    <bpmn:sequenceFlow id="P3_F08" name="Completa (1 solicitud)" sourceRef="P3_Nueva" targetRef="P3_Evidencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">evidencia_completada and solicitudes &lt;= 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P3_F09" name="No / límite" sourceRef="P3_Nueva" targetRef="P3_FinPend"/>
    <bpmn:sequenceFlow id="P3_F10" sourceRef="P3_Validar" targetRef="P3_Revisar"/>
    <bpmn:sequenceFlow id="P3_F11" sourceRef="P3_Revisar" targetRef="P3_Decision"/>
    <bpmn:sequenceFlow id="P3_F12" name="Liberar conforme" sourceRef="P3_Decision" targetRef="P3_Registrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == liberar and verificacion_fisica_conforme</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P3_F13" name="Reprocesar" sourceRef="P3_Decision" targetRef="P3_Reproceso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == reprocesar and reprocesos == 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P3_F14" name="Daño / pérdida / riesgo" sourceRef="P3_Decision" targetRef="P3_Incidencia"/>
    <bpmn:sequenceFlow id="P3_F15" sourceRef="P3_Reproceso" targetRef="P3_Verificar"/>
    <bpmn:sequenceFlow id="P3_F16" sourceRef="P3_Verificar" targetRef="P3_Conforme"/>
    <bpmn:sequenceFlow id="P3_F17" name="Sí" sourceRef="P3_Conforme" targetRef="P3_Registrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">verificacion_fisica_conforme</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P3_F18" name="No (sin nuevo ciclo)" sourceRef="P3_Conforme" targetRef="P3_Incidencia"/>
    <bpmn:sequenceFlow id="P3_F19" sourceRef="P3_Registrar" targetRef="P3_Fin"/>
    <bpmn:sequenceFlow id="P3_F20" sourceRef="P3_Incidencia" targetRef="P3_FinInc"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P3">
    <bpmndi:BPMNPlane id="Plane_P3" bpmnElement="Collaboration_P3">
      <bpmndi:BPMNShape id="Shape_Pool_P3" bpmnElement="Pool_P3" isHorizontal="true">
