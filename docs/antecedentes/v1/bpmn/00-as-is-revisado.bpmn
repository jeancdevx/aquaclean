<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Lavanderia" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Aqua Clean - revisión documental del AS IS" exporterVersion="1.1">
  <bpmn:message id="Msg_Solicitud" name="Solicitud de recojo"/>
  <bpmn:message id="Msg_Confirmacion" name="Confirmación de programación"/>
  <bpmn:message id="Msg_Observacion" name="Observación o reclamo del cliente"/>
  <bpmn:message id="Msg_Retraso" name="Aviso de retraso"/>
  <bpmn:error id="Error_Prenda" name="Prenda dañada o extraviada" errorCode="PRENDA_DANADA_O_EXTRAVIADA"/>
  <bpmn:collaboration id="Collaboration_Lavanderia">
    <bpmn:participant id="Participant_Cliente" name="Cliente corporativo"/>
    <bpmn:participant id="Participant_Lavanderia" name="Lavandería Aqua Clean S.A.C. — Atención del pedido corporativo" processRef="Process_Lavanderia"/>
    <bpmn:messageFlow id="MF_1" name="Solicitud de recojo" sourceRef="Participant_Cliente" targetRef="Start_Solicitud"/>
    <bpmn:messageFlow id="MF_2" name="Confirmación de programación" sourceRef="T_ConfirmarProg" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MF_3" name="Aviso de retraso" sourceRef="T_ComunicarRetraso" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MF_4" name="Guía de entrega para firma" sourceRef="T_ObtenerFirma" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MF_5" name="Observación o reclamo" sourceRef="Participant_Cliente" targetRef="Msg_Obs"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Lavanderia" isExecutable="false">
    <bpmn:documentation>Revisión documental del modelo corporativo recibido, sin agregar actividades de IA al AS IS ni afirmar una nueva observación de campo. Se retiró la anotación de línea base porque el Laboratorio 01 mide atención al detalle. Las esperas y reglas del modelo original requieren ratificación por la organización. Las actividades futuras se encuentran exclusivamente en los TO BE.</bpmn:documentation><bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Asesor de atención al cliente">
        <bpmn:flowNodeRef>EBG_Obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_48h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ComunicarRetraso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Msg_Obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AtenderObs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Habilitado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeHab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ConfirmarProg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Programar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Retraso</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Chofer de recojo y entrega">
        <bpmn:flowNodeRef>Timer_EsperaRuta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Recoger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_24hRecojo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReprogRecojo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_EsperaEntrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_24hEntrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ObtenerFirma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PudoRecoger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReprogEntrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_HayReceptor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Planta de lavado">
        <bpmn:flowNodeRef>SP_ProcesarLote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BND_Timer24h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RecepcionarPesar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Control de calidad y empaque">
        <bpmn:flowNodeRef>G_PasoControl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_VerificarCalidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BND_ErrorPrenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Reprocesar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_AndJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Empacar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_AndSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_MergeInc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Administración y facturación">
        <bpmn:flowNodeRef>T_VerificarDeuda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_SeAutoriza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegistrarCargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_GestionarIncidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ArchivarGuia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Conforme</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F46" sourceRef="T_ArchivarGuia" targetRef="End_Conforme"/>
    <bpmn:sequenceFlow id="F24" sourceRef="BND_ErrorPrenda" targetRef="SP_GestionarIncidencia"/>
    <bpmn:sequenceFlow id="F05" name="No se autoriza" sourceRef="G_SeAutoriza" targetRef="End_Rechazado"/>
    <bpmn:sequenceFlow id="F04" sourceRef="T_VerificarDeuda" targetRef="G_SeAutoriza"/>
    <bpmn:sequenceFlow id="F31" sourceRef="T_RegistrarCargo" targetRef="G_AndJoin"/>
    <bpmn:sequenceFlow id="F30" sourceRef="T_Empacar" targetRef="G_AndJoin"/>
    <bpmn:sequenceFlow id="F29" sourceRef="G_AndSplit" targetRef="T_RegistrarCargo"/>
    <bpmn:sequenceFlow id="F28" sourceRef="G_AndSplit" targetRef="T_Empacar"/>
    <bpmn:sequenceFlow id="F27" sourceRef="G_MergeInc" targetRef="G_AndSplit"/>
    <bpmn:sequenceFlow id="F25" sourceRef="SP_GestionarIncidencia" targetRef="G_MergeInc"/>
    <bpmn:sequenceFlow id="F26" name="Sí, lote conforme" sourceRef="G_PasoControl" targetRef="G_MergeInc"/>
    <bpmn:sequenceFlow id="F22" name="No, hay prendas observadas" sourceRef="G_PasoControl" targetRef="SP_Reprocesar"/>
    <bpmn:sequenceFlow id="F21" sourceRef="SP_VerificarCalidad" targetRef="G_PasoControl"/>
    <bpmn:sequenceFlow id="F23" sourceRef="SP_Reprocesar" targetRef="SP_VerificarCalidad"/>
    <bpmn:sequenceFlow id="F20" sourceRef="SP_ProcesarLote" targetRef="SP_VerificarCalidad"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T_RecepcionarPesar" targetRef="SP_ProcesarLote"/>
    <bpmn:sequenceFlow id="F36" sourceRef="T_ReprogEntrega" targetRef="Timer_24hEntrega"/>
    <bpmn:sequenceFlow id="F38" name="Sí" sourceRef="G_HayReceptor" targetRef="T_ObtenerFirma"/>
    <bpmn:sequenceFlow id="F35" name="No hay quien reciba" sourceRef="G_HayReceptor" targetRef="T_ReprogEntrega"/>
    <bpmn:sequenceFlow id="F34" sourceRef="T_Entregar" targetRef="G_HayReceptor"/>
    <bpmn:sequenceFlow id="F37" sourceRef="Timer_24hEntrega" targetRef="T_Entregar"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Timer_EsperaEntrega" targetRef="T_Entregar"/>
    <bpmn:sequenceFlow id="F32" sourceRef="G_AndJoin" targetRef="Timer_EsperaEntrega"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T_ReprogRecojo" targetRef="Timer_24hRecojo"/>
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="G_PudoRecoger" targetRef="T_RecepcionarPesar"/>
    <bpmn:sequenceFlow id="F13" name="No, la ropa no estaba lista" sourceRef="G_PudoRecoger" targetRef="T_ReprogRecojo"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T_Recoger" targetRef="G_PudoRecoger"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Timer_24hRecojo" targetRef="T_Recoger"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Timer_EsperaRuta" targetRef="T_Recoger"/>
    <bpmn:sequenceFlow id="F42" sourceRef="Msg_Obs" targetRef="T_AtenderObs"/>
    <bpmn:sequenceFlow id="F19" sourceRef="T_ComunicarRetraso" targetRef="End_Retraso"/>
    <bpmn:sequenceFlow id="F18" sourceRef="BND_Timer24h" targetRef="T_ComunicarRetraso"/>
    <bpmn:sequenceFlow id="F45" sourceRef="G_MergeCierre" targetRef="T_ArchivarGuia"/>
    <bpmn:sequenceFlow id="F43" sourceRef="T_AtenderObs" targetRef="G_MergeCierre"/>
    <bpmn:sequenceFlow id="F44" sourceRef="Timer_48h" targetRef="G_MergeCierre"/>
    <bpmn:sequenceFlow id="F41" sourceRef="EBG_Obs" targetRef="Msg_Obs"/>
    <bpmn:sequenceFlow id="F40" sourceRef="EBG_Obs" targetRef="Timer_48h"/>
    <bpmn:sequenceFlow id="F39" sourceRef="T_ObtenerFirma" targetRef="EBG_Obs"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T_ConfirmarProg" targetRef="Timer_EsperaRuta"/>
    <bpmn:sequenceFlow id="F09" sourceRef="T_Programar" targetRef="T_ConfirmarProg"/>
    <bpmn:sequenceFlow id="F08" sourceRef="G_MergeHab" targetRef="T_Programar"/>
    <bpmn:sequenceFlow id="F06" name="Sí, se autoriza" sourceRef="G_SeAutoriza" targetRef="G_MergeHab"/>
    <bpmn:sequenceFlow id="F07" name="Sí" sourceRef="G_Habilitado" targetRef="G_MergeHab"/>
    <bpmn:sequenceFlow id="F03" name="No: contrato vencido o deuda" sourceRef="G_Habilitado" targetRef="T_VerificarDeuda"/>
    <bpmn:sequenceFlow id="F02" sourceRef="T_Registrar" targetRef="G_Habilitado"/>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Solicitud" targetRef="T_Registrar"/>
    <bpmn:boundaryEvent id="BND_ErrorPrenda" name="Prenda dañada o extraviada" attachedToRef="SP_VerificarCalidad">
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_BND_ErrorPrenda" errorRef="Error_Prenda"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_Rechazado" name="Solicitud rechazada por bloqueo comercial">
      <bpmn:incoming>F05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_SeAutoriza" name="¿Se autoriza atender?">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_VerificarDeuda" name="Verificar la deuda y decidir la atención excepcional">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_PasoControl" name="¿El lote pasó el control?">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_VerificarCalidad" name="Verificar la calidad del lote">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:startEvent id="SP2_Start" name="Lote procesado">
        <bpmn:outgoing>SP2_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP2_T1" name="Revisar prenda por prenda contra la guía de recojo">
        <bpmn:incoming>SP2_F1</bpmn:incoming>
        <bpmn:outgoing>SP2_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP2_T2" name="Registrar el resultado en la hoja de control de calidad">
        <bpmn:incoming>SP2_F2</bpmn:incoming>
        <bpmn:outgoing>SP2_F3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP2_G" name="¿Falta o está dañada alguna prenda?">
        <bpmn:incoming>SP2_F3</bpmn:incoming>
        <bpmn:outgoing>SP2_F4</bpmn:outgoing>
        <bpmn:outgoing>SP2_F5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="SP2_End" name="Control de calidad registrado">
        <bpmn:incoming>SP2_F4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="SP2_EndErr" name="Prenda dañada o extraviada">
        <bpmn:incoming>SP2_F5</bpmn:incoming>
        <bpmn:errorEventDefinition id="EED_SP2_EndErr" errorRef="Error_Prenda"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP2_F1" sourceRef="SP2_Start" targetRef="SP2_T1"/>
      <bpmn:sequenceFlow id="SP2_F2" sourceRef="SP2_T1" targetRef="SP2_T2"/>
      <bpmn:sequenceFlow id="SP2_F3" sourceRef="SP2_T2" targetRef="SP2_G"/>
      <bpmn:sequenceFlow id="SP2_F4" name="No" sourceRef="SP2_G" targetRef="SP2_End"/>
      <bpmn:sequenceFlow id="SP2_F5" name="Sí" sourceRef="SP2_G" targetRef="SP2_EndErr"/>
    </bpmn:subProcess>
    <bpmn:manualTask id="T_ObtenerFirma" name="Obtener la firma de conformidad en la guía de entrega">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Timer_24hEntrega" name="Espera al siguiente día hábil">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_24hEntrega">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="T_Entregar" name="Entregar el pedido en el local del cliente">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Timer_EsperaEntrega" name="Espera hasta la ruta de entrega (hasta 12 h)">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_EsperaEntrega">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_ReprogRecojo" name="Reprogramar el recojo y avisar al cliente">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Timer_24hRecojo" name="Espera al siguiente día hábil">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_24hRecojo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="T_Recoger" name="Recoger la ropa en el local del cliente">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="Timer_EsperaRuta" name="Espera hasta la salida de la ruta (hasta 8 h)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_EsperaRuta">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_AtenderObs" name="Registrar la observación y coordinar la solución">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Msg_Obs" name="Observación del cliente recibida">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Msg_Obs" messageRef="Msg_Observacion"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="T_ComunicarRetraso" name="Comunicar el retraso al cliente y escalar al supervisor" messageRef="Msg_Retraso">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_MergeCierre">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Timer_48h" name="48 h sin observaciones: conformidad tácita">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F44</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Timer_48h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="EBG_Obs" name="Esperar la respuesta del cliente">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:startEvent id="Start_Solicitud" name="Solicitud de recojo recibida">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Solicitud" messageRef="Msg_Solicitud"/>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Registrar" name="Registrar la solicitud en el cuaderno de pedidos">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Habilitado" name="¿Cliente habilitado comercialmente?">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_MergeHab">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_ConfirmarProg" name="Confirmar al cliente la fecha y hora de recojo" messageRef="Msg_Confirmacion">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="T_Programar" name="Programar el recojo en la ruta del día">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP_ProcesarLote" name="Procesar el lote en planta">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:startEvent id="SP1_Start" name="Lote recepcionado en planta">
        <bpmn:outgoing>SP1_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP1_T1" name="Separar las prendas por color, fibra y grado de suciedad">
        <bpmn:incoming>SP1_F1</bpmn:incoming>
        <bpmn:outgoing>SP1_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:intermediateCatchEvent id="SP1_Timer" name="Espera de lavadora disponible (hasta 4 h)">
        <bpmn:incoming>SP1_F2</bpmn:incoming>
        <bpmn:outgoing>SP1_F3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_SP1_Timer">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:task id="SP1_T2" name="Cargar la lavadora y dosificar los insumos según el programa">
        <bpmn:incoming>SP1_F3</bpmn:incoming>
        <bpmn:outgoing>SP1_F4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP1_T3" name="Lavar, centrifugar y secar el lote">
        <bpmn:incoming>SP1_F4</bpmn:incoming>
        <bpmn:outgoing>SP1_F5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP1_T4" name="Planchar, doblar y agrupar las prendas por cliente">
        <bpmn:incoming>SP1_F5</bpmn:incoming>
        <bpmn:outgoing>SP1_F6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP1_End" name="Lote listo para control">
        <bpmn:incoming>SP1_F6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP1_F1" sourceRef="SP1_Start" targetRef="SP1_T1"/>
      <bpmn:sequenceFlow id="SP1_F2" sourceRef="SP1_T1" targetRef="SP1_Timer"/>
      <bpmn:sequenceFlow id="SP1_F3" sourceRef="SP1_Timer" targetRef="SP1_T2"/>
      <bpmn:sequenceFlow id="SP1_F4" sourceRef="SP1_T2" targetRef="SP1_T3"/>
      <bpmn:sequenceFlow id="SP1_F5" sourceRef="SP1_T3" targetRef="SP1_T4"/>
      <bpmn:sequenceFlow id="SP1_F6" sourceRef="SP1_T4" targetRef="SP1_End"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BND_Timer24h" name="24 h sin cerrar el lote" cancelActivity="false" attachedToRef="SP_ProcesarLote">
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_BND_Timer24h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="T_RecepcionarPesar" name="Recepcionar, pesar y registrar el lote en planta">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_PudoRecoger" name="¿La ropa estaba disponible?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Retraso" name="Retraso comunicado">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SP_Reprocesar" name="Reprocesar las prendas observadas">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:startEvent id="SP3_Start" name="Lote observado">
        <bpmn:outgoing>SP3_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP3_T1" name="Separar del lote las prendas observadas">
        <bpmn:incoming>SP3_F1</bpmn:incoming>
        <bpmn:outgoing>SP3_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP3_T2" name="Aplicar el tratamiento de manchas">
        <bpmn:incoming>SP3_F2</bpmn:incoming>
        <bpmn:outgoing>SP3_F3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP3_T3" name="Relavar, secar y planchar las prendas">
        <bpmn:incoming>SP3_F3</bpmn:incoming>
        <bpmn:outgoing>SP3_F4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP3_T4" name="Reintegrar las prendas al lote">
        <bpmn:incoming>SP3_F4</bpmn:incoming>
        <bpmn:outgoing>SP3_F5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP3_End" name="Prendas reprocesadas">
        <bpmn:incoming>SP3_F5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP3_F1" sourceRef="SP3_Start" targetRef="SP3_T1"/>
      <bpmn:sequenceFlow id="SP3_F2" sourceRef="SP3_T1" targetRef="SP3_T2"/>
      <bpmn:sequenceFlow id="SP3_F3" sourceRef="SP3_T2" targetRef="SP3_T3"/>
      <bpmn:sequenceFlow id="SP3_F4" sourceRef="SP3_T3" targetRef="SP3_T4"/>
      <bpmn:sequenceFlow id="SP3_F5" sourceRef="SP3_T4" targetRef="SP3_End"/>
    </bpmn:subProcess>
    <bpmn:parallelGateway id="G_AndJoin">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T_Empacar" name="Empacar, etiquetar y armar el pedido">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_RegistrarCargo" name="Registrar el cargo del pedido en el control de facturación">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="G_AndSplit">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G_MergeInc">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_GestionarIncidencia" name="Gestionar la incidencia por prenda dañada o extraviada">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:startEvent id="SP4_Start" name="Incidencia detectada">
        <bpmn:outgoing>SP4_F1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP4_T1" name="Registrar la incidencia y adjuntar la evidencia fotográfica">
        <bpmn:incoming>SP4_F1</bpmn:incoming>
        <bpmn:outgoing>SP4_F2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP4_T2" name="Valorizar la prenda y proponer una compensación">
        <bpmn:incoming>SP4_F2</bpmn:incoming>
        <bpmn:outgoing>SP4_F3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP4_G1" name="¿El cliente acepta la compensación?">
        <bpmn:incoming>SP4_F3</bpmn:incoming>
        <bpmn:outgoing>SP4_F4</bpmn:outgoing>
        <bpmn:outgoing>SP4_F5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP4_T3" name="Aplicar la nota de crédito o reponer la prenda">
        <bpmn:incoming>SP4_F4</bpmn:incoming>
        <bpmn:outgoing>SP4_F6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="SP4_T4" name="Escalar el caso a la administradora">
        <bpmn:incoming>SP4_F5</bpmn:incoming>
        <bpmn:outgoing>SP4_F7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="SP4_G2">
        <bpmn:incoming>SP4_F6</bpmn:incoming>
        <bpmn:incoming>SP4_F7</bpmn:incoming>
        <bpmn:outgoing>SP4_F8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="SP4_T5" name="Comunicar el acuerdo al cliente y archivar el expediente">
        <bpmn:incoming>SP4_F8</bpmn:incoming>
        <bpmn:outgoing>SP4_F9</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP4_End" name="Incidencia cerrada">
        <bpmn:incoming>SP4_F9</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP4_F1" sourceRef="SP4_Start" targetRef="SP4_T1"/>
      <bpmn:sequenceFlow id="SP4_F2" sourceRef="SP4_T1" targetRef="SP4_T2"/>
      <bpmn:sequenceFlow id="SP4_F3" sourceRef="SP4_T2" targetRef="SP4_G1"/>
      <bpmn:sequenceFlow id="SP4_F4" name="Sí" sourceRef="SP4_G1" targetRef="SP4_T3"/>
      <bpmn:sequenceFlow id="SP4_F5" name="No" sourceRef="SP4_G1" targetRef="SP4_T4"/>
      <bpmn:sequenceFlow id="SP4_F6" sourceRef="SP4_T3" targetRef="SP4_G2"/>
      <bpmn:sequenceFlow id="SP4_F7" sourceRef="SP4_T4" targetRef="SP4_G2"/>
      <bpmn:sequenceFlow id="SP4_F8" sourceRef="SP4_G2" targetRef="SP4_T5"/>
      <bpmn:sequenceFlow id="SP4_F9" sourceRef="SP4_T5" targetRef="SP4_End"/>
    </bpmn:subProcess>
    <bpmn:userTask id="T_ReprogEntrega" name="Reprogramar la entrega y avisar al cliente">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_HayReceptor" name="¿Hay personal autorizado para recibir?">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ArchivarGuia" name="Archivar la guía firmada y cerrar el pedido en el registro">
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Conforme" name="Pedido entregado y conforme">
      <bpmn:incoming>F46</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="Ann_Espera">
      <bpmn:text>Alcance corporativo. Línea base pendiente de validación.</bpmn:text>
    </bpmn:textAnnotation>
