<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn" id="Definitions_Integral" targetNamespace="https://aquaclean.example/bpmn" exporter="Aqua Clean - diseño académico BPMN 2.0" exporterVersion="1.0">
  <bpmn:message id="Msg_Integral_S" name="Solicitud recibida"/>
  <bpmn:message id="Msg_Integral_Obs" name="Observación recibida"/>
  <bpmn:collaboration id="Collaboration_Integral">
    <bpmn:participant id="Client_Integral" name="Cliente corporativo / solicitante"/>
    <bpmn:participant id="Pool_Integral" name="Aqua Clean S.A.C. · TO BE integral · Atender el pedido corporativo" processRef="Process_Integral"/>
    <bpmn:messageFlow id="Integral_M1" sourceRef="Client_Integral" targetRef="Integral_S">
      <bpmn:documentation>Solicitud</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="Integral_M2" sourceRef="Client_Integral" targetRef="Integral_Obs">
      <bpmn:documentation>Observación del cliente</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="Integral_M3" sourceRef="Integral_Alerta" targetRef="Client_Integral">
      <bpmn:documentation>Aviso de retraso</bpmn:documentation>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Process_Integral" name="TO BE integral · Atender el pedido corporativo" isExecutable="false">
    <bpmn:documentation>Modelo TO BE propuesto. Los LLM producen propuestas con evidencia; la política, las autorizaciones humanas y los servicios deterministas controlan los cambios. Detalle en el documento del proceso. No es un workflow BPMN ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Integral">
      <bpmn:lane id="Integral_Lane0" name="Atención / sistema multiagente">
        <bpmn:flowNodeRef>Integral_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Registrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Pendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_P2R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Agendado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_P4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Solucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_FinInc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_P2E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_EntregaAgenda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Reclamo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Ventana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_P4C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Resuelto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_FinRecl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_FinAlerta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Integral_Lane1" name="Chofer y planta (trabajo físico)">
        <bpmn:flowNodeRef>Integral_Recoger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Procesar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Empacar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_RecojoOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_EntregaOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_EsperaRecojo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_EsperaEntrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Retraso</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Integral_Lane2" name="Control de calidad / administración">
        <bpmn:flowNodeRef>Integral_P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Calidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Cargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Integral_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Integral_S" name="Solicitud recibida">
      <bpmn:outgoing>Integral_F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Integral_S" messageRef="Msg_Integral_S"/>
    </bpmn:startEvent>
    <bpmn:callActivity id="Integral_P1" name="P1 · Interpretar y registrar solicitud" calledElement="ac:Process_P1">
      <bpmn:incoming>Integral_F01</bpmn:incoming>
      <bpmn:outgoing>Integral_F02</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_Registrado" name="¿Pedido registrado?" default="Integral_F04">
      <bpmn:incoming>Integral_F02</bpmn:incoming>
      <bpmn:outgoing>Integral_F03</bpmn:outgoing>
      <bpmn:outgoing>Integral_F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Integral_Pendiente" name="Solicitud pendiente o no autorizada">
      <bpmn:incoming>Integral_F04</bpmn:incoming>
      <bpmn:incoming>Integral_F08</bpmn:incoming>
      <bpmn:incoming>Integral_F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Integral_P2R" name="P2 · Coordinar recojo" calledElement="ac:Process_P2">
      <bpmn:incoming>Integral_F03</bpmn:incoming>
      <bpmn:incoming>Integral_F11</bpmn:incoming>
      <bpmn:outgoing>Integral_F05</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_Agendado" name="¿Recojo confirmado?" default="Integral_F08">
      <bpmn:incoming>Integral_F05</bpmn:incoming>
      <bpmn:outgoing>Integral_F06</bpmn:outgoing>
      <bpmn:outgoing>Integral_F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Integral_Recoger" name="Recoger y recibir prendas en planta">
      <bpmn:incoming>Integral_F07</bpmn:incoming>
      <bpmn:outgoing>Integral_F09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Integral_Procesar" name="Lavar, secar y planchar según procedimiento">
      <bpmn:incoming>Integral_F10</bpmn:incoming>
      <bpmn:outgoing>Integral_F13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:callActivity id="Integral_P3" name="P3 · Analizar y verificar calidad" calledElement="ac:Process_P3">
      <bpmn:incoming>Integral_F13</bpmn:incoming>
      <bpmn:outgoing>Integral_F14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_Calidad" name="¿Disposición del lote?" default="Integral_F19">
      <bpmn:incoming>Integral_F14</bpmn:incoming>
      <bpmn:outgoing>Integral_F17</bpmn:outgoing>
      <bpmn:outgoing>Integral_F18</bpmn:outgoing>
      <bpmn:outgoing>Integral_F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Integral_P4" name="P4 · Resolver incidencia del lote" calledElement="ac:Process_P4">
      <bpmn:incoming>Integral_F18</bpmn:incoming>
      <bpmn:outgoing>Integral_F20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_Solucion" name="¿Solución cumplida?" default="Integral_F22">
      <bpmn:incoming>Integral_F20</bpmn:incoming>
      <bpmn:outgoing>Integral_F21</bpmn:outgoing>
      <bpmn:outgoing>Integral_F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Integral_FinInc" name="Incidencia abierta o cierre sin entrega">
      <bpmn:incoming>Integral_F19</bpmn:incoming>
      <bpmn:incoming>Integral_F22</bpmn:incoming>
      <bpmn:incoming>Integral_F28</bpmn:incoming>
      <bpmn:incoming>Integral_F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Integral_Empacar" name="Empacar y etiquetar prendas liberadas">
      <bpmn:incoming>Integral_F17</bpmn:incoming>
      <bpmn:incoming>Integral_F21</bpmn:incoming>
      <bpmn:outgoing>Integral_F23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Integral_Cargo" name="Registrar cargo y documentación comercial">
      <bpmn:incoming>Integral_F23</bpmn:incoming>
      <bpmn:outgoing>Integral_F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="Integral_P2E" name="P2 · Coordinar entrega" calledElement="ac:Process_P2">
      <bpmn:incoming>Integral_F24</bpmn:incoming>
      <bpmn:incoming>Integral_F31</bpmn:incoming>
      <bpmn:outgoing>Integral_F25</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_EntregaAgenda" name="¿Entrega confirmada?" default="Integral_F28">
      <bpmn:incoming>Integral_F25</bpmn:incoming>
      <bpmn:outgoing>Integral_F26</bpmn:outgoing>
      <bpmn:outgoing>Integral_F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Integral_Entregar" name="Entregar y obtener firma de recepción">
      <bpmn:incoming>Integral_F27</bpmn:incoming>
      <bpmn:outgoing>Integral_F29</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:eventBasedGateway id="Integral_Reclamo" name="Esperar observación o fin de ventana">
      <bpmn:incoming>Integral_F30</bpmn:incoming>
      <bpmn:outgoing>Integral_F33</bpmn:outgoing>
      <bpmn:outgoing>Integral_F34</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Integral_Obs" name="Observación recibida">
      <bpmn:incoming>Integral_F33</bpmn:incoming>
      <bpmn:outgoing>Integral_F35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Def_Integral_Obs" messageRef="Msg_Integral_Obs"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Integral_Ventana" name="48 h sin observación">
      <bpmn:incoming>Integral_F34</bpmn:incoming>
      <bpmn:outgoing>Integral_F36</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Integral_Ventana">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="Integral_P4C" name="P4 · Gestionar reclamo posterior" calledElement="ac:Process_P4">
      <bpmn:incoming>Integral_F35</bpmn:incoming>
      <bpmn:outgoing>Integral_F37</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Integral_Resuelto" name="¿Reclamo resuelto?" default="Integral_F39">
      <bpmn:incoming>Integral_F37</bpmn:incoming>
      <bpmn:outgoing>Integral_F38</bpmn:outgoing>
      <bpmn:outgoing>Integral_F39</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Integral_FinRecl" name="Pedido entregado con reclamo abierto">
      <bpmn:incoming>Integral_F39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Integral_Cerrar" name="Verificar guía y cerrar registro del pedido">
      <bpmn:incoming>Integral_F36</bpmn:incoming>
      <bpmn:incoming>Integral_F38</bpmn:incoming>
      <bpmn:outgoing>Integral_F40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Integral_Fin" name="Pedido entregado y documentado">
      <bpmn:incoming>Integral_F40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Integral_RecojoOK" name="¿Recojo realizado?" default="Integral_F12">
      <bpmn:incoming>Integral_F09</bpmn:incoming>
      <bpmn:outgoing>Integral_F10</bpmn:outgoing>
      <bpmn:outgoing>Integral_F11</bpmn:outgoing>
      <bpmn:outgoing>Integral_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Integral_EntregaOK" name="¿Entrega realizada?" default="Integral_F32">
      <bpmn:incoming>Integral_F29</bpmn:incoming>
      <bpmn:outgoing>Integral_F30</bpmn:outgoing>
      <bpmn:outgoing>Integral_F31</bpmn:outgoing>
      <bpmn:outgoing>Integral_F32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Integral_EsperaRecojo" name="Esperar el horario confirmado de recojo">
      <bpmn:incoming>Integral_F06</bpmn:incoming>
      <bpmn:outgoing>Integral_F07</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Integral_EsperaRecojo">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">fecha_hora_recojo_confirmada</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Integral_EsperaEntrega" name="Esperar el horario confirmado de entrega">
      <bpmn:incoming>Integral_F26</bpmn:incoming>
      <bpmn:outgoing>Integral_F27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Integral_EsperaEntrega">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">fecha_hora_entrega_confirmada</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent id="Integral_Retraso" name="24 h sin completar planta" attachedToRef="Integral_Procesar" cancelActivity="false">
      <bpmn:outgoing>Integral_F15</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_Integral_Retraso">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Integral_Alerta" name="Comunicar retraso y revisar compromiso">
      <bpmn:incoming>Integral_F15</bpmn:incoming>
      <bpmn:outgoing>Integral_F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Integral_FinAlerta" name="Aviso registrado; planta continúa">
      <bpmn:incoming>Integral_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Integral_F01" sourceRef="Integral_S" targetRef="Integral_P1"/>
    <bpmn:sequenceFlow id="Integral_F02" sourceRef="Integral_P1" targetRef="Integral_Registrado"/>
    <bpmn:sequenceFlow id="Integral_F03" name="Registrado / existente" sourceRef="Integral_Registrado" targetRef="Integral_P2R">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">pedido_registrado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F04" name="Otro resultado" sourceRef="Integral_Registrado" targetRef="Integral_Pendiente"/>
    <bpmn:sequenceFlow id="Integral_F05" sourceRef="Integral_P2R" targetRef="Integral_Agendado"/>
    <bpmn:sequenceFlow id="Integral_F06" name="Sí" sourceRef="Integral_Agendado" targetRef="Integral_EsperaRecojo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recojo_confirmado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F07" sourceRef="Integral_EsperaRecojo" targetRef="Integral_Recoger"/>
    <bpmn:sequenceFlow id="Integral_F08" name="No" sourceRef="Integral_Agendado" targetRef="Integral_Pendiente"/>
    <bpmn:sequenceFlow id="Integral_F09" sourceRef="Integral_Recoger" targetRef="Integral_RecojoOK"/>
    <bpmn:sequenceFlow id="Integral_F10" name="Sí" sourceRef="Integral_RecojoOK" targetRef="Integral_Procesar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recojo_realizado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F11" name="Fallo: 1 reprogramación" sourceRef="Integral_RecojoOK" targetRef="Integral_P2R">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not recojo_realizado and reprogramaciones_recojo &lt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F12" name="Límite" sourceRef="Integral_RecojoOK" targetRef="Integral_Pendiente"/>
    <bpmn:sequenceFlow id="Integral_F13" sourceRef="Integral_Procesar" targetRef="Integral_P3"/>
    <bpmn:sequenceFlow id="Integral_F14" sourceRef="Integral_P3" targetRef="Integral_Calidad"/>
    <bpmn:sequenceFlow id="Integral_F15" sourceRef="Integral_Retraso" targetRef="Integral_Alerta"/>
    <bpmn:sequenceFlow id="Integral_F16" sourceRef="Integral_Alerta" targetRef="Integral_FinAlerta"/>
    <bpmn:sequenceFlow id="Integral_F17" name="Liberado" sourceRef="Integral_Calidad" targetRef="Integral_Empacar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">lote_liberado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F18" name="Incidencia" sourceRef="Integral_Calidad" targetRef="Integral_P4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">incidencia_abierta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F19" name="Pendiente técnico" sourceRef="Integral_Calidad" targetRef="Integral_FinInc"/>
    <bpmn:sequenceFlow id="Integral_F20" sourceRef="Integral_P4" targetRef="Integral_Solucion"/>
    <bpmn:sequenceFlow id="Integral_F21" name="Lote liberado" sourceRef="Integral_Solucion" targetRef="Integral_Empacar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">solucion_cumplida and lote_liberado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F22" name="No / sin entrega" sourceRef="Integral_Solucion" targetRef="Integral_FinInc"/>
    <bpmn:sequenceFlow id="Integral_F23" sourceRef="Integral_Empacar" targetRef="Integral_Cargo"/>
    <bpmn:sequenceFlow id="Integral_F24" sourceRef="Integral_Cargo" targetRef="Integral_P2E"/>
    <bpmn:sequenceFlow id="Integral_F25" sourceRef="Integral_P2E" targetRef="Integral_EntregaAgenda"/>
    <bpmn:sequenceFlow id="Integral_F26" name="Sí" sourceRef="Integral_EntregaAgenda" targetRef="Integral_EsperaEntrega">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">entrega_confirmada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F27" sourceRef="Integral_EsperaEntrega" targetRef="Integral_Entregar"/>
    <bpmn:sequenceFlow id="Integral_F28" name="No; agenda pendiente" sourceRef="Integral_EntregaAgenda" targetRef="Integral_FinInc"/>
    <bpmn:sequenceFlow id="Integral_F29" sourceRef="Integral_Entregar" targetRef="Integral_EntregaOK"/>
    <bpmn:sequenceFlow id="Integral_F30" name="Sí" sourceRef="Integral_EntregaOK" targetRef="Integral_Reclamo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">entrega_realizada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F31" name="Fallo: 1 reprogramación" sourceRef="Integral_EntregaOK" targetRef="Integral_P2E">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not entrega_realizada and reprogramaciones_entrega &lt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F32" name="Límite" sourceRef="Integral_EntregaOK" targetRef="Integral_FinInc"/>
    <bpmn:sequenceFlow id="Integral_F33" sourceRef="Integral_Reclamo" targetRef="Integral_Obs"/>
    <bpmn:sequenceFlow id="Integral_F34" sourceRef="Integral_Reclamo" targetRef="Integral_Ventana"/>
    <bpmn:sequenceFlow id="Integral_F35" sourceRef="Integral_Obs" targetRef="Integral_P4C"/>
    <bpmn:sequenceFlow id="Integral_F36" sourceRef="Integral_Ventana" targetRef="Integral_Cerrar"/>
    <bpmn:sequenceFlow id="Integral_F37" sourceRef="Integral_P4C" targetRef="Integral_Resuelto"/>
    <bpmn:sequenceFlow id="Integral_F38" name="Sí" sourceRef="Integral_Resuelto" targetRef="Integral_Cerrar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reclamo_resuelto</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Integral_F39" name="No" sourceRef="Integral_Resuelto" targetRef="Integral_FinRecl"/>
    <bpmn:sequenceFlow id="Integral_F40" sourceRef="Integral_Cerrar" targetRef="Integral_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Integral">
    <bpmndi:BPMNPlane id="Plane_Integral" bpmnElement="Collaboration_Integral">
      <bpmndi:BPMNShape id="Shape_Client_Integral" bpmnElement="Client_Integral" isHorizontal="true">
        <dc:Bounds x="50" y="30" width="5245" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Pool_Integral" bpmnElement="Pool_Integral" isHorizontal="true">
        <dc:Bounds x="50" y="170" width="5245" height="1080"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Integral_Lane0" bpmnElement="Integral_Lane0" isHorizontal="true">
        <dc:Bounds x="80" y="170" width="5215" height="360"/>
      </bpmndi:BPMNShape>
