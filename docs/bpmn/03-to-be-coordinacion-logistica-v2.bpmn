<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn/v2" id="Definitions_P2" targetNamespace="https://aquaclean.example/bpmn/v2" exporter="Aqua Clean - diseño académico BPMN 2.0" exporterVersion="2.0"><bpmn:error id="Err_P2_Error" name="Fallo técnico" errorCode="TECHNICAL_FAILURE"/>
  <bpmn:collaboration id="Collaboration_P2">
    <bpmn:participant id="Client_P2" name="Cliente corporativo / solicitante"/>
    <bpmn:participant id="Pool_P2" name="Aqua Clean S.A.C. · P2 · Coordinar recojos, entregas y reprogramaciones" processRef="Process_P2"/>
    <bpmn:messageFlow id="P2_M1" sourceRef="P2_Proponer" targetRef="Client_P2">
      <bpmn:documentation>Alternativas</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="P2_M2" sourceRef="Client_P2" targetRef="P2_Respuesta">
      <bpmn:documentation>Elección</bpmn:documentation>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="P2_M3" sourceRef="P2_Confirmar" targetRef="Client_P2">
      <bpmn:documentation>Horario confirmado</bpmn:documentation>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <bpmn:process id="Process_P2" name="P2 · Coordinar recojos, entregas y reprogramaciones" isExecutable="false">
    <bpmn:documentation>Especificación TO BE V2 propuesta para lavandería al detalle. Modelo TO BE propuesto. Los LLM producen propuestas con evidencia; la política, las autorizaciones humanas y los servicios deterministas controlan los cambios. Detalle en el documento del proceso. No es un workflow BPMN ejecutable. Se aplican PLAN_ALINEADO_V2.md y DESCRIPCIONES_TO_BE_V2.md. No acredita implementación del SDK Deep Agents o LangSmith en el commit auditado.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_P2">
      <bpmn:lane id="P2_Lane0" name="Agente de logística / supervisor">
        <bpmn:flowNodeRef>P2_Analizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Proponer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Respuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Eleccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_Lane1" name="Servicios de agenda y política">
        <bpmn:flowNodeRef>P2_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Contexto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Opciones</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Viable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Revision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Reservar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Error</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_Lane2" name="Asesor / responsable de logística">
        <bpmn:flowNodeRef>P2_Humano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_Autoriza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_FinNo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_S" name="Solicitud de recojo u orden READY para entrega">
      <bpmn:outgoing>P2_F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="P2_Contexto" name="Consultar referencia objetivo agenda capacidad y fase">
      <bpmn:incoming>P2_F01</bpmn:incoming>
      <bpmn:outgoing>P2_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_Analizar" name="Interpretar urgencia y preferencias">
      <bpmn:incoming>P2_F02</bpmn:incoming>
      <bpmn:incoming>P2_F11</bpmn:incoming>
      <bpmn:outgoing>P2_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="P2_Opciones" name="Calcular opciones factibles con reglas">
      <bpmn:incoming>P2_F03</bpmn:incoming>
      <bpmn:outgoing>P2_F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_Viable" name="¿Hay opciones factibles?" default="P2_F06">
      <bpmn:incoming>P2_F04</bpmn:incoming>
      <bpmn:outgoing>P2_F05</bpmn:outgoing>
      <bpmn:outgoing>P2_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P2_Proponer" name="Explicar alternativas y compromisos">
      <bpmn:incoming>P2_F05</bpmn:incoming>
      <bpmn:outgoing>P2_F07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="P2_Respuesta" name="Esperar elección o contrapropuesta">
      <bpmn:incoming>P2_F07</bpmn:incoming>
      <bpmn:outgoing>P2_F08</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="P2_Timeout" name="24 h sin elección" attachedToRef="P2_Respuesta" cancelActivity="true">
      <bpmn:outgoing>P2_F09</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Def_P2_Timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="P2_Eleccion" name="¿Elección compatible?" default="P2_F12">
      <bpmn:incoming>P2_F08</bpmn:incoming>
      <bpmn:outgoing>P2_F10</bpmn:outgoing>
      <bpmn:outgoing>P2_F11</bpmn:outgoing>
      <bpmn:outgoing>P2_F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="P2_Validar" name="Validar permiso referencia versión y liberación para entrega">
      <bpmn:incoming>P2_F10</bpmn:incoming>
      <bpmn:outgoing>P2_F13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="P2_Revision" name="¿Requiere aprobación?" default="P2_F15">
      <bpmn:incoming>P2_F13</bpmn:incoming>
      <bpmn:outgoing>P2_F14</bpmn:outgoing>
      <bpmn:outgoing>P2_F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_Humano" name="Resolver conflicto de capacidad o plazo">
      <bpmn:incoming>P2_F06</bpmn:incoming>
      <bpmn:incoming>P2_F09</bpmn:incoming>
      <bpmn:incoming>P2_F12</bpmn:incoming>
      <bpmn:incoming>P2_F15</bpmn:incoming>
      <bpmn:incoming>P2_F20</bpmn:incoming>
      <bpmn:outgoing>P2_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_Autoriza" name="¿Autoriza un plan factible?" default="P2_F18">
      <bpmn:incoming>P2_F16</bpmn:incoming>
      <bpmn:outgoing>P2_F17</bpmn:outgoing>
      <bpmn:outgoing>P2_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P2_FinNo" name="Caso pendiente con responsable">
      <bpmn:incoming>P2_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P2_Reservar" name="Reservar / actualizar agenda de forma atómica">
      <bpmn:incoming>P2_F14</bpmn:incoming>
      <bpmn:incoming>P2_F17</bpmn:incoming>
      <bpmn:outgoing>P2_F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="P2_Error" name="Conflicto o fallo de agenda" attachedToRef="P2_Reservar" cancelActivity="true">
      <bpmn:outgoing>P2_F20</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Def_P2_Error" errorRef="Err_P2_Error"/>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="P2_Confirmar" name="Confirmar horario realmente reservado">
      <bpmn:incoming>P2_F19</bpmn:incoming>
      <bpmn:outgoing>P2_F21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="P2_Fin" name="Agenda confirmada">
      <bpmn:incoming>P2_F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_F01" sourceRef="P2_S" targetRef="P2_Contexto"/>
    <bpmn:sequenceFlow id="P2_F02" sourceRef="P2_Contexto" targetRef="P2_Analizar"/>
    <bpmn:sequenceFlow id="P2_F03" sourceRef="P2_Analizar" targetRef="P2_Opciones"/>
    <bpmn:sequenceFlow id="P2_F04" sourceRef="P2_Opciones" targetRef="P2_Viable"/>
    <bpmn:sequenceFlow id="P2_F05" name="Sí" sourceRef="P2_Viable" targetRef="P2_Proponer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">opciones_factibles</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_F06" name="No" sourceRef="P2_Viable" targetRef="P2_Humano"/>
    <bpmn:sequenceFlow id="P2_F07" sourceRef="P2_Proponer" targetRef="P2_Respuesta"/>
    <bpmn:sequenceFlow id="P2_F08" sourceRef="P2_Respuesta" targetRef="P2_Eleccion"/>
    <bpmn:sequenceFlow id="P2_F09" name="Sin respuesta" sourceRef="P2_Timeout" targetRef="P2_Humano"/>
    <bpmn:sequenceFlow id="P2_F10" name="Seleccionada y factible" sourceRef="P2_Eleccion" targetRef="P2_Validar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">eleccion_factible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_F11" name="Contrapropuesta (hasta 2 rondas)" sourceRef="P2_Eleccion" targetRef="P2_Analizar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">contrapropuesta and rondas &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_F12" name="Rechazo / límite" sourceRef="P2_Eleccion" targetRef="P2_Humano"/>
    <bpmn:sequenceFlow id="P2_F13" sourceRef="P2_Validar" targetRef="P2_Revision"/>
    <bpmn:sequenceFlow id="P2_F14" name="Dentro de política" sourceRef="P2_Revision" targetRef="P2_Reservar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not requiere_aprobacion</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_F15" name="Sí" sourceRef="P2_Revision" targetRef="P2_Humano"/>
    <bpmn:sequenceFlow id="P2_F16" sourceRef="P2_Humano" targetRef="P2_Autoriza"/>
    <bpmn:sequenceFlow id="P2_F17" name="Sí" sourceRef="P2_Autoriza" targetRef="P2_Reservar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">autorizacion_valida and plan_factible</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P2_F18" name="No" sourceRef="P2_Autoriza" targetRef="P2_FinNo"/>
    <bpmn:sequenceFlow id="P2_F19" sourceRef="P2_Reservar" targetRef="P2_Confirmar"/>
    <bpmn:sequenceFlow id="P2_F20" name="No confirmar el horario" sourceRef="P2_Error" targetRef="P2_Humano"/>
    <bpmn:sequenceFlow id="P2_F21" sourceRef="P2_Confirmar" targetRef="P2_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2">
    <bpmndi:BPMNPlane id="Plane_P2" bpmnElement="Collaboration_P2">
      <bpmndi:BPMNShape id="Shape_Client_P2" bpmnElement="Client_P2" isHorizontal="true">
