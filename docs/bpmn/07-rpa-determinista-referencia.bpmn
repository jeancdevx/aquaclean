<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RecojoToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:message id="Msg_Solicitud" name="Solicitud de recojo" />
  <bpmn:error id="Error_Registro" name="Fallo del servicio de registro" errorCode="FALLO_REGISTRO" />
  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Cliente" name="Cliente corporativo (solicitante)" />
    <bpmn:participant id="Participant_Lav" name="Lavandería Aqua Clean S.A.C. — Registrar y programar la solicitud de recojo (TO-BE)" processRef="Process_ToBe" />
    <bpmn:messageFlow id="MF_1" name="Solicitud de recojo (JSON)" sourceRef="Participant_Cliente" targetRef="Start_Solicitud" />
    <bpmn:messageFlow id="MF_2" name="HTTP 400 · errores del contrato" sourceRef="T_Responder400" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF_3" name="HTTP 200 · pedido existente" sourceRef="T_Responder200" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF_4" name="HTTP 202 · pendiente de autorización" sourceRef="T_Responder202" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF_5" name="Confirmación de fecha y turno" sourceRef="T_Confirmar" targetRef="Participant_Cliente" />
    <bpmn:messageFlow id="MF_6" name="HTTP 201 · numero_pedido" sourceRef="T_Responder201" targetRef="Participant_Cliente" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Robot" name="Robot de registro (n8n)">
        <bpmn:flowNodeRef>T_PrepararColaDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ColaFallidosDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Responder400</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Responder200</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegistrarDerivacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Responder202</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Contrato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_BuscarClave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Normalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Duplicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Padron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Duplicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_EstadoCliente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AsignarTurno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegistrarPedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BND_FalloRegistro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PrepararColaSistema</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ColaFallidosSistema</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Responder500</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AlertarAsesor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Responder201</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Registrado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Asesor" name="Asesor de atención al cliente">
        <bpmn:flowNodeRef>T_AtenderFallo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reproceso</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="Administración y facturación">
        <bpmn:flowNodeRef>T_DecidirAtencion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Derivada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="T_PrepararColaDatos" name="Preparar la entrada de la cola con los seis campos">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ColaFallidosDatos" name="Registrar el rechazo en la cola de fallidos">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Responder400" name="Responder 400 con el detalle del error">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Rechazada" name="Solicitud rechazada por datos">
      <bpmn:incoming>F06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Responder200" name="Responder 200 con el pedido existente">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_RegistrarDerivacion" name="Registrar la derivación a administración">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Responder202" name="Responder 202 · pendiente de autorización">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_DecidirAtencion" name="Verificar la deuda y decidir la atención excepcional">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Derivada" name="Caso derivado a administración">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_AtenderFallo" name="Atender la alerta y reprocesar el caso desde la cola">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Reproceso" name="Caso pendiente de reproceso">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start_Solicitud" targetRef="T_Validar" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_Validar" targetRef="G_Contrato" />
    <bpmn:sequenceFlow id="F03" name="No cumple" sourceRef="G_Contrato" targetRef="T_PrepararColaDatos" />
    <bpmn:sequenceFlow id="F04" sourceRef="T_PrepararColaDatos" targetRef="T_ColaFallidosDatos" />
    <bpmn:sequenceFlow id="F05" sourceRef="T_ColaFallidosDatos" targetRef="T_Responder400" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_Responder400" targetRef="End_Rechazada" />
    <bpmn:sequenceFlow id="F07" name="Sí cumple" sourceRef="G_Contrato" targetRef="T_Normalizar" />
    <bpmn:sequenceFlow id="F08" sourceRef="T_Normalizar" targetRef="T_BuscarClave" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_BuscarClave" targetRef="G_Duplicado" />
    <bpmn:sequenceFlow id="F10" name="Sí, la clave ya existe" sourceRef="G_Duplicado" targetRef="T_Responder200" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Responder200" targetRef="End_Duplicado" />
    <bpmn:sequenceFlow id="F12" name="No, es un pedido nuevo" sourceRef="G_Duplicado" targetRef="T_Padron" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_Padron" targetRef="G_EstadoCliente" />
    <bpmn:sequenceFlow id="F14" name="Habilitado" sourceRef="G_EstadoCliente" targetRef="T_AsignarTurno" />
    <bpmn:sequenceFlow id="F15" name="Bloqueado por deuda o contrato" sourceRef="G_EstadoCliente" targetRef="T_RegistrarDerivacion" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_RegistrarDerivacion" targetRef="T_Responder202" />
    <bpmn:sequenceFlow id="F17" sourceRef="T_Responder202" targetRef="T_DecidirAtencion" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_DecidirAtencion" targetRef="End_Derivada" />
    <bpmn:sequenceFlow id="F19" name="No existe en el padrón" sourceRef="G_EstadoCliente" targetRef="T_PrepararColaDatos" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_AsignarTurno" targetRef="T_RegistrarPedido" />
    <bpmn:sequenceFlow id="F21" sourceRef="T_RegistrarPedido" targetRef="T_Confirmar" />
    <bpmn:sequenceFlow id="F22" sourceRef="T_Confirmar" targetRef="T_Responder201" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_Responder201" targetRef="End_Registrado" />
    <bpmn:sequenceFlow id="F24" sourceRef="BND_FalloRegistro" targetRef="T_PrepararColaSistema" />
    <bpmn:sequenceFlow id="F25" sourceRef="T_PrepararColaSistema" targetRef="T_ColaFallidosSistema" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_ColaFallidosSistema" targetRef="T_Responder500" />
    <bpmn:sequenceFlow id="F27" sourceRef="T_Responder500" targetRef="T_AlertarAsesor" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_AlertarAsesor" targetRef="T_AtenderFallo" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_AtenderFallo" targetRef="End_Reproceso" />
    <bpmn:exclusiveGateway id="G_Contrato" name="¿La solicitud cumple el contrato?">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Validar" name="Validar la solicitud contra el contrato">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Start_Solicitud" name="Solicitud de recojo recibida">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start_Solicitud" messageRef="Msg_Solicitud" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_BuscarClave" name="Consultar si la clave ya existe en el registro">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Normalizar" name="Normalizar los datos y calcular la clave del pedido">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Duplicado" name="¿El pedido ya fue registrado?">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Padron" name="Consultar el padrón de clientes">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Duplicado" name="Pedido ya registrado">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_EstadoCliente" name="¿Cuál es la situación comercial del cliente?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_AsignarTurno" name="Asignar el turno de la ruta de recojo">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_RegistrarPedido" name="Registrar el pedido en el control de pedidos">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BND_FalloRegistro" name="Fallo del servicio de registro" attachedToRef="T_RegistrarPedido">
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_BND_FalloRegistro" errorRef="Error_Registro" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_PrepararColaSistema" name="Preparar la entrada de la cola con la carga original">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_ColaFallidosSistema" name="Registrar el fallo en la cola de fallidos">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Responder500" name="Responder 500 sin dar el pedido por registrado">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_AlertarAsesor" name="Alertar al asesor del caso pendiente">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_Responder201" name="Responder 201 con el número de pedido">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_Confirmar" name="Confirmar al solicitante la fecha y el turno">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Registrado" name="Pedido registrado y confirmado">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
