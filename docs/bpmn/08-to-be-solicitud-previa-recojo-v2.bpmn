      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Fin_DI" bpmnElement="Q_Fin" bioc:fill="#FFFFFF" bioc:stroke="#334155">
        <dc:Bounds x="2030" y="704.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1995" y="748.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_Pend_DI" bpmnElement="Q_Pend" bioc:fill="#FEF3C7" bioc:stroke="#334155">
        <dc:Bounds x="2220" y="180.0" width="150" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_FinPend_DI" bpmnElement="Q_FinPend" bioc:fill="#FFFFFF" bioc:stroke="#334155">
        <dc:Bounds x="2410" y="204.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2375" y="248.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
