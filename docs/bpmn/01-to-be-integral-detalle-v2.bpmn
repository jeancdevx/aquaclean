<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn/v2" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Def_IntegralDetalle" targetNamespace="https://aquaclean.example/bpmn/v2" exporter="Aqua Clean especificación alineada V2" exporterVersion="2.0">
  <bpmn:collaboration id="Coll_IntegralDetalle">
    <bpmn:participant id="Pool_IntegralDetalle" name="Aqua Clean · Gestionar el pedido de lavandería al detalle" processRef="Process_IntegralDetalle"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_IntegralDetalle" name="Gestionar el pedido de lavandería al detalle" isExecutable="false">
    <bpmn:documentation>TO BE propuesto V2 para lavandería al detalle. No acredita código ejecutado. Personas verifican prendas; IA propone; servicios validan y escriben. Descripciones y condiciones en PLAN_ALINEADO_V2.md y DESCRIPCIONES_TO_BE_V2.md. Parámetros de laboratorio no equivalen a políticas ratificadas.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_IntegralDetalle">
      <bpmn:lane id="IntegralDetalle_Lane0" name="Operador y cliente · verificación humana">
        <bpmn:flowNodeRef>I_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Canal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Recoger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_RecoOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Procesar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Modalidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Entregar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Cobrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_FinPend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IntegralDetalle_Lane1" name="Agentes y subprocesos de apoyo">
        <bpmn:flowNodeRef>I_P1R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_P1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_P3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_P4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="IntegralDetalle_Lane2" name="Servicios deterministas y persistencia">
        <bpmn:flowNodeRef>I_SolOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_P2R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_AgReco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Orden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Disposicion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Aviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_P2E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_AgEnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Saldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_CierreOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_Alerta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_FinAlerta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="I_S" name="Solicitud de servicio al detalle">
      <bpmn:outgoing>IntegralDetalle_F00</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="I_Canal" name="¿Requiere recojo previo?" default="IntegralDetalle_F02">
      <bpmn:incoming>IntegralDetalle_F00</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F01</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="I_P1R" name="P1R · Registrar solicitud previa" calledElement="ac:Process_P1R">
      <bpmn:incoming>IntegralDetalle_F01</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F29</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="I_SolOk" name="¿Solicitud registrada?" default="IntegralDetalle_F31">
      <bpmn:incoming>IntegralDetalle_F29</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F30</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="I_P2R" name="P2 · Coordinar recojo por solicitud" calledElement="ac:Process_P2">
      <bpmn:incoming>IntegralDetalle_F30</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F32</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="I_AgReco" name="¿Recojo reservado?" default="IntegralDetalle_F34">
      <bpmn:incoming>IntegralDetalle_F32</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F33</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="I_Recoger" name="Recoger prendas y documentar resultado">
      <bpmn:incoming>IntegralDetalle_F33</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="I_RecoOk" name="¿Recojo realizado?" default="IntegralDetalle_F05">
      <bpmn:incoming>IntegralDetalle_F03</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F04</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="I_Recibir" name="Recibir prendas efectivamente">
      <bpmn:incoming>IntegralDetalle_F02</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F04</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:callActivity id="I_P1" name="P1 · Recepción y orden al detalle" calledElement="ac:Process_P1">
      <bpmn:incoming>IntegralDetalle_F06</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F07</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="I_Orden" name="¿Orden RECEIVED confirmada?" default="IntegralDetalle_F09">
      <bpmn:incoming>IntegralDetalle_F07</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F08</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="I_Procesar" name="Iniciar y completar lavado secado planchado">
      <bpmn:incoming>IntegralDetalle_F08</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:callActivity id="I_P3" name="P3 · Calidad y verificación física" calledElement="ac:Process_P3">
      <bpmn:incoming>IntegralDetalle_F10</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="I_Disposicion" name="¿Disposición registrada?" default="IntegralDetalle_F14">
      <bpmn:incoming>IntegralDetalle_F11</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F12</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F13</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="I_P4" name="P4 · Investigar incidencia vinculada" calledElement="ac:Process_P4">
      <bpmn:incoming>IntegralDetalle_F13</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sendTask id="I_Aviso" name="Avisar prendas listas por outbox local">
      <bpmn:incoming>IntegralDetalle_F12</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="I_Modalidad" name="¿Entrega a domicilio?" default="IntegralDetalle_F18">
      <bpmn:incoming>IntegralDetalle_F16</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F17</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="I_P2E" name="P2 · Coordinar entrega de orden READY" calledElement="ac:Process_P2">
      <bpmn:incoming>IntegralDetalle_F17</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F35</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="I_AgEnt" name="¿Entrega reservada?" default="IntegralDetalle_F37">
      <bpmn:incoming>IntegralDetalle_F35</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F36</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="I_Entregar" name="Registrar entrega receptor y conformidad">
      <bpmn:incoming>IntegralDetalle_F18</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F36</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="I_Saldo" name="Calcular saldo con registros de cobro">
      <bpmn:incoming>IntegralDetalle_F19</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F20</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="I_Cobrar" name="Registrar cobro declarado o verificar saldo cero">
      <bpmn:incoming>IntegralDetalle_F20</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="I_Validar" name="Validar entrega conformidad saldo e incidencias">
      <bpmn:incoming>IntegralDetalle_F21</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="I_CierreOk" name="¿Requisitos de cierre cumplidos?" default="IntegralDetalle_F24">
      <bpmn:incoming>IntegralDetalle_F22</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F23</bpmn:outgoing>
      <bpmn:outgoing>IntegralDetalle_F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="I_Cerrar" name="Emitir comprobante demo y cerrar orden">
      <bpmn:incoming>IntegralDetalle_F23</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="I_Fin" name="Pedido entregado conforme y cobrado">
      <bpmn:incoming>IntegralDetalle_F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="I_Pend" name="Gestionar pendiente o reprogramación explícita">
      <bpmn:incoming>IntegralDetalle_F05</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F09</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F14</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F15</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F24</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F31</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F34</bpmn:incoming>
      <bpmn:incoming>IntegralDetalle_F37</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="I_FinPend" name="Pendiente con responsable">
      <bpmn:incoming>IntegralDetalle_F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="I_Timer" name="24 h sin completar procesamiento" attachedToRef="I_Procesar" cancelActivity="false">
      <bpmn:outgoing>IntegralDetalle_F27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="I_Timer_Def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="I_Alerta" name="Alertar retraso sin detener procesamiento">
      <bpmn:incoming>IntegralDetalle_F27</bpmn:incoming>
      <bpmn:outgoing>IntegralDetalle_F28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="I_FinAlerta" name="Alerta registrada">
      <bpmn:incoming>IntegralDetalle_F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="IntegralDetalle_F00" sourceRef="I_S" targetRef="I_Canal"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F01" sourceRef="I_Canal" targetRef="I_P1R" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">canal_recojo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F02" sourceRef="I_Canal" targetRef="I_Recibir" name="Mostrador"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F03" sourceRef="I_Recoger" targetRef="I_RecoOk"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F04" sourceRef="I_RecoOk" targetRef="I_Recibir" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">recojo_realizado</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F05" sourceRef="I_RecoOk" targetRef="I_Pend" name="No"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F06" sourceRef="I_Recibir" targetRef="I_P1"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F07" sourceRef="I_P1" targetRef="I_Orden"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F08" sourceRef="I_Orden" targetRef="I_Procesar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">orden_received</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F09" sourceRef="I_Orden" targetRef="I_Pend" name="No"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F10" sourceRef="I_Procesar" targetRef="I_P3"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F11" sourceRef="I_P3" targetRef="I_Disposicion"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F12" sourceRef="I_Disposicion" targetRef="I_Aviso" name="Lista">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">estado == READY</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F13" sourceRef="I_Disposicion" targetRef="I_P4" name="Incidencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">incidencia_abierta</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F14" sourceRef="I_Disposicion" targetRef="I_Pend" name="Pendiente"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F15" sourceRef="I_P4" targetRef="I_Pend"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F16" sourceRef="I_Aviso" targetRef="I_Modalidad"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F17" sourceRef="I_Modalidad" targetRef="I_P2E" name="Domicilio">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">entrega_domicilio</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F18" sourceRef="I_Modalidad" targetRef="I_Entregar" name="Mostrador"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F19" sourceRef="I_Entregar" targetRef="I_Saldo"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F20" sourceRef="I_Saldo" targetRef="I_Cobrar"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F21" sourceRef="I_Cobrar" targetRef="I_Validar"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F22" sourceRef="I_Validar" targetRef="I_CierreOk"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F23" sourceRef="I_CierreOk" targetRef="I_Cerrar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">entregado and conformidad and saldo == 0 and not incidencia_bloqueante</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F24" sourceRef="I_CierreOk" targetRef="I_Pend" name="No"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F25" sourceRef="I_Cerrar" targetRef="I_Fin"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F26" sourceRef="I_Pend" targetRef="I_FinPend"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F27" sourceRef="I_Timer" targetRef="I_Alerta"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F28" sourceRef="I_Alerta" targetRef="I_FinAlerta"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F29" sourceRef="I_P1R" targetRef="I_SolOk"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F30" sourceRef="I_SolOk" targetRef="I_P2R" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">solicitud_registrada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F31" sourceRef="I_SolOk" targetRef="I_Pend" name="No"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F32" sourceRef="I_P2R" targetRef="I_AgReco"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F33" sourceRef="I_AgReco" targetRef="I_Recoger" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reserva_recojo_confirmada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F34" sourceRef="I_AgReco" targetRef="I_Pend" name="No"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F35" sourceRef="I_P2E" targetRef="I_AgEnt"/>
    <bpmn:sequenceFlow id="IntegralDetalle_F36" sourceRef="I_AgEnt" targetRef="I_Entregar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reserva_entrega_confirmada</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IntegralDetalle_F37" sourceRef="I_AgEnt" targetRef="I_Pend" name="No"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_IntegralDetalle">
    <bpmndi:BPMNPlane id="Plane_IntegralDetalle" bpmnElement="Coll_IntegralDetalle">
      <bpmndi:BPMNShape id="Pool_IntegralDetalle_DI" bpmnElement="Pool_IntegralDetalle" isHorizontal="true">
        <dc:Bounds x="40" y="100" width="6100" height="1090"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntegralDetalle_Lane0_DI" bpmnElement="IntegralDetalle_Lane0" isHorizontal="true">
        <dc:Bounds x="70" y="100" width="6070" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntegralDetalle_Lane1_DI" bpmnElement="IntegralDetalle_Lane1" isHorizontal="true">
        <dc:Bounds x="70" y="350" width="6070" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntegralDetalle_Lane2_DI" bpmnElement="IntegralDetalle_Lane2" isHorizontal="true">
        <dc:Bounds x="70" y="600" width="6070" height="590"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_S_DI" bpmnElement="I_S" bioc:fill="#FFFFFF" bioc:stroke="#334155">
        <dc:Bounds x="130" y="204.0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="95" y="248.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_Canal_DI" bpmnElement="I_Canal" isMarkerVisible="true" bioc:fill="#FEF9C3" bioc:stroke="#334155">
        <dc:Bounds x="320" y="197.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="255.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_P1R_DI" bpmnElement="I_P1R" isExpanded="false" bioc:fill="#DBEAFE" bioc:stroke="#334155">
        <dc:Bounds x="510" y="430.0" width="150" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_SolOk_DI" bpmnElement="I_SolOk" isMarkerVisible="true" bioc:fill="#FEF9C3" bioc:stroke="#334155">
        <dc:Bounds x="700" y="697.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="755.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_P2R_DI" bpmnElement="I_P2R" isExpanded="false" bioc:fill="#DBEAFE" bioc:stroke="#334155">
        <dc:Bounds x="890" y="680.0" width="150" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="I_AgReco_DI" bpmnElement="I_AgReco" isMarkerVisible="true" bioc:fill="#FEF9C3" bioc:stroke="#334155">
        <dc:Bounds x="1080" y="697.0" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1045" y="755.0" width="110" height="46"/>
        </bpmndi:BPMNLabel>
