<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ac="https://aquaclean.example/bpmn/v2" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Def_P1" targetNamespace="https://aquaclean.example/bpmn/v2" exporter="Aqua Clean especificación alineada V2" exporterVersion="2.0">
  <bpmn:collaboration id="Coll_P1">
    <bpmn:participant id="Pool_P1" name="Aqua Clean · P1 · Asistir recepción y abrir orden de servicio" processRef="Process_P1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_P1" name="P1 · Asistir recepción y abrir orden de servicio" isExecutable="false">
    <bpmn:documentation>TO BE propuesto V2 para lavandería al detalle. No acredita código ejecutado. Personas verifican prendas; IA propone; servicios validan y escriben. Descripciones y condiciones en PLAN_ALINEADO_V2.md y DESCRIPCIONES_TO_BE_V2.md. Parámetros de laboratorio no equivalen a políticas ratificadas.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_P1">
      <bpmn:lane id="P1_Lane0" name="Operador y cliente · verificación humana">
        <bpmn:flowNodeRef>R_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Preguntar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Confirmar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Acepta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Adelanto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_FinPend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane1" name="Agentes y subprocesos de apoyo">
        <bpmn:flowNodeRef>R_Interpretar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Resumen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_Lane2" name="Servicios deterministas y persistencia">
        <bpmn:flowNodeRef>R_Evidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Suficiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Calcular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Cobro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Constancia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="R_S" name="Prendas recibidas realmente">
      <bpmn:outgoing>P1_F00</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="R_Verificar" name="Identificar cliente y registrar prendas servicios y hallazgos">
      <bpmn:incoming>P1_F00</bpmn:incoming>
      <bpmn:outgoing>P1_F01</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="R_Evidencia" name="Cargar evidencia y datos de recepción">
      <bpmn:incoming>P1_F01</bpmn:incoming>
      <bpmn:incoming>P1_F07</bpmn:incoming>
      <bpmn:outgoing>P1_F02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_Interpretar" name="Atención estructura datos y detecta faltantes">
      <bpmn:incoming>P1_F02</bpmn:incoming>
      <bpmn:outgoing>P1_F03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="R_Suficiente" name="¿Datos completos y sustentados?" default="P1_F06">
      <bpmn:incoming>P1_F03</bpmn:incoming>
      <bpmn:outgoing>P1_F04</bpmn:outgoing>
      <bpmn:outgoing>P1_F05</bpmn:outgoing>
      <bpmn:outgoing>P1_F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="R_Preguntar" name="Aclarar datos o corregir recepción">
      <bpmn:incoming>P1_F05</bpmn:incoming>
      <bpmn:incoming>P1_F12</bpmn:incoming>
      <bpmn:outgoing>P1_F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="R_Calcular" name="Calcular tarifa importes saldo y fecha prometida">
      <bpmn:incoming>P1_F04</bpmn:incoming>
      <bpmn:outgoing>P1_F08</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="R_Resumen" name="Explicar resumen y fuentes de cada dato">
      <bpmn:incoming>P1_F08</bpmn:incoming>
      <bpmn:outgoing>P1_F09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="R_Confirmar" name="Revisar y confirmar recepción y cotización">
      <bpmn:incoming>P1_F09</bpmn:incoming>
      <bpmn:outgoing>P1_F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="R_Acepta" name="¿Confirma la versión vigente?" default="P1_F13">
      <bpmn:incoming>P1_F10</bpmn:incoming>
      <bpmn:outgoing>P1_F11</bpmn:outgoing>
      <bpmn:outgoing>P1_F12</bpmn:outgoing>
      <bpmn:outgoing>P1_F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="R_Validar" name="Revalidar permisos datos evidencia y versión">
      <bpmn:incoming>P1_F11</bpmn:incoming>
      <bpmn:outgoing>P1_F14</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="R_Registrar" name="Crear cliente si es nuevo y orden con líneas atómicamente">
      <bpmn:incoming>P1_F14</bpmn:incoming>
      <bpmn:outgoing>P1_F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="R_Adelanto" name="Declarar adelanto recibido o ausencia de adelanto">
      <bpmn:incoming>P1_F15</bpmn:incoming>
      <bpmn:outgoing>P1_F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="R_Cobro" name="Registrar cobro idempotente y recalcular saldo">
      <bpmn:incoming>P1_F16</bpmn:incoming>
      <bpmn:outgoing>P1_F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="R_Constancia" name="Emitir constancia de recepción de demostración">
      <bpmn:incoming>P1_F17</bpmn:incoming>
      <bpmn:outgoing>P1_F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="R_Fin" name="Orden RECEIVED y saldo persistidos">
      <bpmn:incoming>P1_F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="R_Pend" name="Guardar recepción pendiente con motivo">
      <bpmn:incoming>P1_F06</bpmn:incoming>
      <bpmn:incoming>P1_F13</bpmn:incoming>
      <bpmn:outgoing>P1_F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="R_FinPend" name="No afirmar orden creada">
      <bpmn:incoming>P1_F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_F00" sourceRef="R_S" targetRef="R_Verificar"/>
    <bpmn:sequenceFlow id="P1_F01" sourceRef="R_Verificar" targetRef="R_Evidencia"/>
    <bpmn:sequenceFlow id="P1_F02" sourceRef="R_Evidencia" targetRef="R_Interpretar"/>
    <bpmn:sequenceFlow id="P1_F03" sourceRef="R_Interpretar" targetRef="R_Suficiente"/>
    <bpmn:sequenceFlow id="P1_F04" sourceRef="R_Suficiente" targetRef="R_Calcular" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">datos_completos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P1_F05" sourceRef="R_Suficiente" targetRef="R_Preguntar" name="Aclarable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">faltantes and rondas &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P1_F06" sourceRef="R_Suficiente" targetRef="R_Pend" name="No resoluble"/>
    <bpmn:sequenceFlow id="P1_F07" sourceRef="R_Preguntar" targetRef="R_Evidencia"/>
    <bpmn:sequenceFlow id="P1_F08" sourceRef="R_Calcular" targetRef="R_Resumen"/>
    <bpmn:sequenceFlow id="P1_F09" sourceRef="R_Resumen" targetRef="R_Confirmar"/>
    <bpmn:sequenceFlow id="P1_F10" sourceRef="R_Confirmar" targetRef="R_Acepta"/>
    <bpmn:sequenceFlow id="P1_F11" sourceRef="R_Acepta" targetRef="R_Validar" name="Sí">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">confirmacion_vigente</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P1_F12" sourceRef="R_Acepta" targetRef="R_Preguntar" name="Corregir">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">correccion and rondas &lt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P1_F13" sourceRef="R_Acepta" targetRef="R_Pend" name="Rechazo o límite"/>
    <bpmn:sequenceFlow id="P1_F14" sourceRef="R_Validar" targetRef="R_Registrar"/>
    <bpmn:sequenceFlow id="P1_F15" sourceRef="R_Registrar" targetRef="R_Adelanto"/>
    <bpmn:sequenceFlow id="P1_F16" sourceRef="R_Adelanto" targetRef="R_Cobro"/>
    <bpmn:sequenceFlow id="P1_F17" sourceRef="R_Cobro" targetRef="R_Constancia"/>
    <bpmn:sequenceFlow id="P1_F18" sourceRef="R_Constancia" targetRef="R_Fin"/>
    <bpmn:sequenceFlow id="P1_F19" sourceRef="R_Pend" targetRef="R_FinPend"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P1">
    <bpmndi:BPMNPlane id="Plane_P1" bpmnElement="Coll_P1">
      <bpmndi:BPMNShape id="Pool_P1_DI" bpmnElement="Pool_P1" isHorizontal="true">
