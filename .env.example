APP_MODE=local
AUTH_MODE=demo_local
APP_TIMEZONE=America/Lima
POSTGRES_USER=aquaclean
POSTGRES_PASSWORD=aquaclean_local_only
POSTGRES_DB=aquaclean
DATABASE_URL=postgresql://aquaclean:aquaclean_local_only@db:5432/aquaclean
GEMINI_API_KEY=
# Verificar con `python -m aquaclean.cli models`; no todos los modelos están habilitados en todas las cuentas.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=10
MAX_CONTEXT_CHARS=60000
MAX_PENDING_RUNS=20
MAX_CLARIFICATIONS=2
WAIT_HOURS=24
MAX_UPLOAD_MB=10
MAX_ATTACHMENTS=5
MAX_PDF_PAGES=20
MAX_AUDIO_SECONDS=120
SLOT_CAPACITY=8
MAX_BAGS=40
MAX_PICKUP_DAYS=30
MAX_REPROCESSES=1
MAX_QUALITY_EVIDENCE_REQUESTS=1
MAX_INCIDENT_CLARIFICATIONS=1
PILOT_MORNING_DISPATCH=10:30:00
PILOT_AFTERNOON_DISPATCH=16:00:00
MEDIA_ROOT=/data/media
